# SUBway demo credentials — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real tokens.

# --- GitHub (repo read access for manifest scanning) ---
# Fine-grained PAT with Contents:read on the seed repos (or classic PAT with `repo` scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Account whose repos get scanned
GITHUB_USERNAME=syang0624

# --- Supabase (Management API for listing + pausing projects) ---
# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
# Project ref of the seeded idle project (the one the demo pauses)
SUPABASE_DEMO_PROJECT_REF=abcdefghijklmnop
# Project ref of the healthy tasktomo-db project (graph display only)
SUPABASE_TASKTOMO_PROJECT_REF=

# --- OpenAI ---
# Regular key: powers byLLM explanation generation
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Admin key (sk-admin-...): required for the usage/costs API; leave blank to
# fall back to fixtures/openai_usage.json
OPENAI_ADMIN_KEY=

# --- Demo behavior ---
# true  = connectors read from fixtures/ (deterministic, offline-safe rehearsal)
# false = live API calls (the real demo)
DEMO_MODE=false
